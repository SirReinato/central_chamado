# Configuracoes do Servidor
SECRET_KEY=sua-chave-secreta-super-segura-aqui
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

# Configuracoes de Banco de Dados (opcional para producao)
# DATABASE_URL=sqlite:///chamados.db

# Configuracoes de Rede / Impressoras
# SNMP_COMMUNITY=public
# DC1_HOSTNAME=dc1

# Configuracoes de E-mail corporativo (Exchange / Outlook / Microsoft 365)
# Servidor de e-mail: utilize smtp.seu-dominio.com.br ou smtp.office365.com
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
# Conta utilizada para autenticar no servidor SMTP (seu usuario de rede/e-mail)
SMTP_USER=seu.email@empresa.com.br
SMTP_PASSWORD=sua_senha_ou_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Conta com permissao de envio delegado ("Enviar Como" / "Send As")
MAIL_FROM_ADDRESS=ti@empresa.com.br
MAIL_FROM_NAME=Departamento de TI
MAIL_DEFAULT_RECIPIENT=ti@empresa.com.br

# =====================================================================
# Configuracoes de Integracao GLPI (Modo Ultra-Seguro / Leitura Apenas)
# =====================================================================
# Habilita ou desabilita o sincronizador em segundo plano
GLPI_ENABLE_SYNC=false

# URL base da API REST do GLPI (sem barra no final)
# Para GLPI 10+ com nova API: https://helpdesk.suaempresa.com.br/api.php
GLPI_API_URL=https://helpdesk.brasfort.com.br/api.php

# Credenciais do Cliente OAuth criadas no GLPI (Menu: Configurar > Geral > API / Clientes de API)
GLPI_CLIENT_ID=seu_client_id_oauth_aqui
GLPI_CLIENT_SECRET=seu_client_secret_oauth_aqui

# Credenciais do usuario de servico no GLPI
GLPI_USERNAME=usuario_servico_glpi
GLPI_PASSWORD=senha_do_usuario_aqui

# Contexto de Perfil e Entidade da API REST v2.3 do GLPI (Necessario para enxergar chamados de toda a organizacao)
# Perfil 4 = Super-Admin (permite ver tickets abertos por outros usuarios)
GLPI_PROFILE_ID=4
# Entidade 0 = Entidade Raiz
GLPI_ENTITY_ID=0
# Se true, expande a busca recursivamente para todas as entidades filhas
GLPI_ENTITY_RECURSIVE=true

# Politica de Protecao de Carga:
# Intervalo em minutos entre cada varredura (Recomendado: 30 minutos para nao onerar o GLPI)
GLPI_SYNC_INTERVAL_MINUTES=30

# Quantidade maxima de tickets a consultar por ciclo (evita transferencias pesadas)
GLPI_BATCH_SIZE=30

# Timeout maximo em segundos para qualquer chamada HTTP ao GLPI (evita travar threads)
GLPI_REQUEST_TIMEOUT=15

# Filtros para capturar chamados:
# Se 'true', busca estritamente chamados abertos no GLPI (status 1=Novo, 2=Em atendimento, 3=Planejado, 4=Pendente)
GLPI_FILTER_ONLY_OPEN=true

# Nome de usuario do tecnico a considerar para chamados atribuidos (se nao for 'Novo')
# Exemplo: 'renato.lima'
GLPI_TECH_USERNAME=renato.lima

# No GLPI, tipo de requisicao padrao para helpdesk/formulario web geralmente e 1 ou id customizado
GLPI_FILTER_REQUEST_TYPE_ID=1

# Opcional: ID de categoria especifica associada ao formulario (deixe vazio se nao usar)
GLPI_FILTER_CATEGORY_ID=

# Opcional: Se 'true', importa estritamente chamados originados de formularios (ex: criacao de usuario)
GLPI_FILTER_ONLY_FORMS=false

